# Copy this file to .env.local and fill in the values. .env.local is gitignored.

# --- Google AI / Genkit (server-side, used by license-plate scanning) ---
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- WhatsApp Cloud API (server-side, optional) ---
# When set, receipts are delivered automatically after payment to customers who
# agreed to receive them. Without these, the attendant can still open WhatsApp
# with the receipt pre-filled and press Send by hand.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# An approved template is needed to message a customer who has not written to
# you in the last 24 hours. It must take 8 body parameters, in this order:
# receipt id, date, vehicle, services, total, paid, owed on account, payment methods.
WHATSAPP_RECEIPT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_API_VERSION=v22.0
