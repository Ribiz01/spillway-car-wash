rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    /**
     * Returns true if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Returns true if the authenticated user's UID matches the provided userId.
     * Use this to verify a user owns a specific document or data tree.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * Returns true if the document being accessed already exists in Firestore.
     * CRITICAL: Always use this for update and delete operations.
     */
    function isExistingDoc() {
      return resource != null;
    }

    /**
     * Checks if the user is an admin by reading the 'role' field
     * from their user profile document.
     */
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    /**
     * Returns true if the user is the original creator of a document
     * or if the user is an admin.
     */
    function isCreatorOrAdmin(creatorId) {
      return isOwner(creatorId) || isAdmin();
    }
    
    /**
     * Validates that the 'userId' field in a new document matches the
     * authenticated user's UID. Enforces ownership on creation.
     */
    function isNewDocCreator(docData) {
      return docData.userId == request.auth.uid;
    }

    /**
     * Validates that the 'userId' field is immutable on update.
     * Prevents re-assigning ownership of a document.
     */
    function isUserIdImmutable() {
      return request.resource.data.userId == resource.data.userId;
    }
    
    /**
     * Checks if the requesting user is the owner of a given transaction or an admin.
     * Requires a get() call, as security is derived from a related document.
     */
    function isTransactionOwnerOrAdmin(transactionId) {
      let transaction = get(/databases/$(database)/documents/transactions/$(transactionId)).data;
      return transaction.userId == request.auth.uid || isAdmin();
    }

    // ----------------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------------

    /**
     * @description Users can create and manage their own profile document. Admins can list all users.
     * @path /users/{userId}
     * @allow (create) A new user with UID 'user123' creates their own profile at `/users/user123`.
     * @deny (list) A non-admin user tries to list documents in the `/users` collection.
     * @principle Restricts access to a user's own data tree and prevents user enumeration for non-admins.
     */
    /**
     * Returns true if the 'role' field is not being changed by this write.
     * CRITICAL: without this, any signed-in user could set their own role to
     * 'Admin' by writing to their own profile document.
     */
    function isRoleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }

    match /users/{userId} {
      // Each signed-in user can read their own profile. Admins can read all profiles.
      allow get: if isOwner(userId) || isAdmin();
      // Only admins may enumerate the user collection.
      allow list: if isAdmin();
      // Self-registration may only ever create an Attendant. Admins can create any role.
      allow create: if isAdmin()
                    || (isOwner(userId) && request.resource.data.role == 'Attendant');
      // Users may edit their own profile but NOT their own role. Admins may edit roles.
      allow update: if isExistingDoc()
                    && (isAdmin() || (isOwner(userId) && isRoleUnchanged()));
      allow delete: if isAdmin();
    }

    /**
     * @description Any authenticated employee can add and view vehicles. Only admins can modify or delete vehicle records.
     * @path /vehicles/{vehicleId}
     * @allow (create) A signed-in attendant (non-admin) creates a new vehicle document.
     * @deny (delete) A signed-in attendant (non-admin) tries to delete an existing vehicle document.
     * @principle Allows broad creation/read access for employees while protecting data integrity via admin-only writes.
     */
    match /vehicles/{vehicleId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      // Attendants may fill in or correct the customer-facing details of a known
      // vehicle (a returning car with no phone number cannot be sent a receipt or
      // earn loyalty points), but never its plate or type.
      allow update: if isExistingDoc()
                    && (isAdmin()
                        || (isSignedIn()
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                              'make', 'model', 'ownerName', 'phoneNumber',
                              'whatsappReceiptConsent', 'photoDataUri'
                            ])));
      allow delete: if isAdmin() && isExistingDoc();
    }

    /**
     * @description Service offerings are viewable by all employees but can only be created, updated, or deleted by admins.
     * @path /services/{serviceId}
     * @allow (list) A signed-in attendant (non-admin) lists all available services to create a transaction.
     * @deny (create) A signed-in attendant (non-admin) tries to create a new service.
     * @principle Public read for internal users, with controlled writes for administrators.
     */
    match /services/{serviceId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && isExistingDoc();
    }

    match /washers/{washerId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Branches. Every employee reads them (their own branch is shown
     * in the header and stamped on washes); only admins manage them.
     */
    match /locations/{locationId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Loyalty members, keyed by normalised phone number. Points are
     * credited from the till when a wash is paid for, so any signed-in employee
     * may create or update one. Only admins may delete.
     */
    match /customers/{customerId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    /**
     * @description Money paid out of the business. Admin-only, and the recorder
     * is fixed at creation so an expense always has an owner.
     */
    match /expenses/{expenseId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() && isExistingDoc()
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin() && isExistingDoc();
    }

    /**
     * @description Employees can create transactions they are responsible for. All employees can view transactions for operational purposes, but only the original creator or an admin can modify or delete them.
     * @path /transactions/{transactionId}
     * @allow (create) Attendant 'user123' creates a transaction, setting the `userId` field to 'user123'.
     * @deny (update) Attendant 'user456' tries to update a transaction where the `userId` field is 'user123'.
     * @principle Enforces document ownership for writes while allowing broader read access for business operations.
     */
    match /transactions/{transactionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // A job checked in by one attendant is very often completed by another —
      // shifts change while a car is still on the ramp. So any signed-in employee
      // may finish a job that is still 'In Progress'. Once it is completed or
      // billed, it locks back down to its creator or an admin, so yesterday's
      // takings cannot be quietly edited from the wash bay.
      // `userId` (who checked the car in) is immutable in every case.
      allow update: if isSignedIn()
                    && isExistingDoc()
                    && request.resource.data.userId == resource.data.userId
                    && (isAdmin()
                        || isOwner(resource.data.userId)
                        || resource.data.status == 'In Progress'
                        // Whoever took the payment records whether the receipt
                        // reached the customer. That happens just AFTER the job
                        // locks, so it is allowed for these two fields only.
                        || request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['receiptDeliveryStatus', 'receiptDeliveryError']));
      allow delete: if isExistingDoc() && isCreatorOrAdmin(resource.data.userId);
    }

    /**
     * @description Receipts are linked to transactions. Their security follows the parent transaction: an employee can manage receipts for transactions they created, and admins have full access.
     * @path /receipts/{receiptId}
     * @allow (create) Attendant 'user123' creates a receipt for a transaction that they also created.
     * @deny (create) Attendant 'user456' tries to create a receipt for a transaction created by 'user123'.
     * @principle Derives security from a related document using a `get()` call to check the parent transaction's ownership.
     */
    match /receipts/{receiptId} {
      allow get, list: if isSignedIn();
      // `&&` binds tighter than `||`, so the original read as
      // `(isSignedIn() && get(...)) || isAdmin()`. Admins were fine, but for a
      // non-admin the get() ran against a transaction that may not exist, and
      // dereferencing .data on a missing document errors the whole evaluation.
      // Test isAdmin() first to short-circuit, and guard the get() with exists().
      allow create: if isAdmin()
                    || (isSignedIn()
                        && exists(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId))
                        && get(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.userId == request.auth.uid);
      allow update, delete: if isAdmin()
                    || (isExistingDoc()
                        && exists(/databases/$(database)/documents/transactions/$(resource.data.transactionId))
                        && get(/databases/$(database)/documents/transactions/$(resource.data.transactionId)).data.userId == request.auth.uid);
    }

    /**
     * @description Companies billed on account. Attendants must read these to bill a
     * wash; only admins may create or change them.
     */
    match /corporateAccounts/{accountId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && isExistingDoc();
    }

    /**
     * @description Payments received against outstanding corporate washes.
     * Admin-only, and immutable once written — a settlement is a financial record,
     * so corrections are made by writing a new one, never by editing history.
     */
    match /settlements/{settlementId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.settledByUid == request.auth.uid;
      allow update, delete: if false;
    }

    /**
     * @description End-of-day reconciliation records, keyed by date (YYYY-MM-DD).
     * Admins may re-close a day (a recount is legitimate) but never delete one.
     */
    match /cashups/{date} {
      // Any signed-in employee may READ a day's reconciliation. Attendants are
      // the ones holding the float, so they are trusted to see what the drawer
      // should contain and whether the day has already been closed.
      // Closing or re-closing a day remains admin-only.
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && request.resource.data.closedByUid == request.auth.uid;
      allow delete: if false;
    }

    /**
     * @description Stores offline data synchronization status. Writes are currently disabled because the schema lacks an ownership field.
     * @path /sync_status/{syncStatusId}
     * @allow (get) An admin views a sync status document.
     * @deny (create) Any non-admin user tries to create a sync status record.
     * @principle Secures internal system data. Writes are disabled pending schema changes to enforce ownership.
     */
    match /sync_status/{syncStatusId} {
      allow get, list: if isAdmin();
      // CRITICAL: Cannot implement user-specific writes. The 'SyncStatus' entity is missing a 'userId' or 'ownerId' field.
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}
